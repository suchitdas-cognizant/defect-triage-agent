# Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Jira Cloud REST v3
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace_with_your_jira_api_token
JIRA_PROJECT_KEY=QE

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
SLACK_ONCALL_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# SMTP email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password

# PagerDuty Events API
PAGERDUTY_KEY=replace_with_pagerduty_routing_key

# Local ChromaDB persistence
CHROMA_DIR=./data/chroma
